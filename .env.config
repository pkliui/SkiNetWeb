# Non-secret deployment config, tracked in git so it's diffable via PRs and
# reaches every environment (Studio, EC2) on checkout with no manual sync.
# Real credentials (MISTRAL_API_KEY, OPENROUTER_API_KEY, KAGGLE_KEY,
# KAGGLE_USERNAME) are NOT here — they stay in the gitignored .env locally,
# and in GitHub Secrets for CI, merged into the final .env at deploy time.

OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_BASE_URL=

MISTRAL_MODEL=ministral-8b-latest
MISTRAL_BASE_URL=

# Single source of truth for the upload limit shared by backend and skinet-service
# (docker-compose*.yml pass it to both, unchanged). Both containers fail to
# start if this is unset, so edit only here to change it.
MAX_UPLOAD_BYTES=10485760

# Single source of truth for skinet-service's config path, model path, and
# slow-request log interval (docker-compose*.yml pass these through unchanged).
# The container fails to start if any is unset, so edit only here to change them.
CONFIG_PATH=/models/main_config.yaml
MODEL_PATH=/models/ios_onnx.onnx
INFER_SLOW_WARN_SECONDS=10

# Single source of truth for the case-report concurrency ceiling, shared by the
# backend (Express) and skinet-service (Python httpx pool sizing). Both
# containers fail to start if this is unset, so edit only here to change it.
MAX_CASE_REPORT_CONCURRENCY=5
