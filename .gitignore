# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# frontend
/skinetweb-ui/node_modules

# backend
/skinetweb-server/node_modules
/skinetweb-server/dist
/skinetweb-server/.env
/skinetweb-server/src/**/*.js
/skinetweb-server/src/**/*.js.map
/skinetweb-server/src/**/*.d.ts
/skinetweb-server/src/**/*.d.ts.map

# models
models/*.ckpt
models/*.pt
models/*.pth

# secrets — Compose reads .env from repo root (Kaggle creds, etc.)
.env
.kaggle/

# misc
.DS_Store
npm-debug.log*
__pycache__/
*.pyc
skinetweb-ui/public/examples/isic/*.jpg
skinetweb-ui/public/examples/isic/*.png
skinetweb-ui/public/examples/*.bmp
skinetweb-ui/public/model_selection/*.png
